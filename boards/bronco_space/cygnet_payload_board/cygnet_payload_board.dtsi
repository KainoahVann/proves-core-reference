&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <100000>;

	ina260_ch0: ina260@40 { //3.3V monitor
		compatible = "ti,ina260";
		reg = <0x40>;
	};
	ina260_ch1: ina260@41 { //12V monitor
		compatible = "ti,ina260";
		reg = <0x41>;
	};
	ina260_ch2: ina260@4A { //GPS monitor
		compatible = "ti,ina260";
		reg = <0x4A>;
	};
	ina260_ch3: ina260@45 { //7V monitor
		compatible = "ti,ina260";
		reg = <0x45>;
	};
	tmp117: tmp117@48 {
		compatible = "ti,tmp117";
		reg = <0x48>;
	};

};

// GPIO Expander IO
/ {

    // Define the GPIO outputs based on your schematic
    gpio_outputs {
        compatible = "gpio-leds";  // Using gpio-leds as a convenient container
    };

    // Define GPIO inputs
    gpio_inputs {
      compatible = "gpio-keys"; 
    };
};
